<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- Delete the GLOBAL restrictive base rule -->
    <delete model="ir.rule" id="project.task_type_visibility_rule"/>

    <!-- Allow all internal users to read every task stage -->
    <record id="project_task_type_rule_all" model="ir.rule">
        <field name="name">Task Type: read all stages</field>
        <field name="model_id" ref="project.model_project_task_type"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Allow all internal users to read all projects -->
    <record id="project_project_rule_all" model="ir.rule">
        <field name="name">Project: read all projects</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Allow all internal users to read all tasks -->
    <record id="project_task_rule_all" model="ir.rule">
        <field name="name">Task: read all tasks</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>