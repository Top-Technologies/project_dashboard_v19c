<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_milestone_form_inherit_phase_order" model="ir.ui.view">
        <field name="name">project.milestone.form.inherit.phase.order</field>
        <field name="model">project.milestone</field>
        <field name="inherit_id" ref="project.project_milestone_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="dashboard_settings" string="Dashboard Settings">
                    <field name="sequence" string="Phase Order (Sequence)"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
