<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_inherit_client_actions" model="ir.ui.view">
        <field name="name">project.task.form.inherit.client.actions</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Client Actions" name="client_actions">
                    <field name="client_action_ids" context="{'default_project_id': project_id, 'default_task_id': id}">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="project_id" column_invisible="1"/>
                            <field name="task_id" column_invisible="1"/>
                            <field name="assigned_partner_id"/>
                            <field name="date_due"/>
                            <field name="status"/>
                            <field name="is_done"/>
                        </list>
                    </field>
                </page>
                <page string="Risks &amp; Issues" name="risks_issues">
                    <field name="risk_issue_ids" context="{'default_project_id': project_id, 'default_task_id': id}">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="project_id" column_invisible="1"/>
                            <field name="task_id" column_invisible="1"/>
                            <field name="type"/>
                            <field name="severity"/>
                            <field name="status"/>
                            <field name="assigned_user_id"/>
                            <field name="target_date"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
