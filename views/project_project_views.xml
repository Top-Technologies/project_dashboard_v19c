<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view: statusbar in header -->
    <record id="view_project_project_form_status" model="ir.ui.view">
        <field name="name">project.project.form.status</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="x_project_status" widget="statusbar"
                       statusbar_visible="new,in_progress,on_hold,done,cancelled"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="x_project_status"/>
                <field name="x_project_type"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Risks &amp; Issues" name="risks_issues">
                    <field name="x_risk_issue_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="type"/>
                            <field name="severity" widget="badge"
                                   decoration-danger="severity == 'high'"
                                   decoration-warning="severity == 'medium'"
                                   decoration-success="severity == 'low'"/>
                            <field name="status" widget="badge"
                                   decoration-info="status == 'open'"
                                   decoration-warning="status == 'in_progress'"
                                   decoration-success="status in ('mitigated', 'closed')"/>
                            <field name="assigned_user_id"/>
                            <field name="target_date"/>
                            <field name="mitigation_plan"/>
                        </list>
                    </field>
                </page>
                <page string="Client Pending Actions" name="client_actions">
                    <field name="x_client_action_ids">
                        <list editable="bottom">
                            <field name="is_done" widget="boolean_toggle"/>
                            <field name="name"/>
                            <field name="date_due"/>
                            <field name="status" widget="badge"
                                   decoration-warning="status == 'pending'"
                                   decoration-info="status == 'in_progress'"
                                   decoration-success="status == 'approved'"
                                   decoration-danger="status == 'rejected'"/>
                            <field name="assigned_partner_id"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Kanban view: status badge on each card -->
    <record id="view_project_kanban_status" model="ir.ui.view">
        <field name="name">project.project.kanban.status</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']" position="inside">
                <div class="mt-2 d-flex flex-wrap align-items-center gap-1 w-100">
                    <field name="x_project_status" widget="badge"
                           decoration-info="x_project_status == 'new'"
                           decoration-warning="x_project_status in ('in_progress', 'on_hold')"
                           decoration-success="x_project_status == 'done'"
                           decoration-danger="x_project_status == 'cancelled'"/>
                    <field name="x_project_type" widget="badge"
                           decoration-info="x_project_type == 'client'"
                           decoration-muted="x_project_type == 'internal'"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- List view: status badge after project name -->
    <record id="view_project_list_status" model="ir.ui.view">
        <field name="name">project.project.list.status</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_project_status" widget="badge"
                       decoration-info="x_project_status == 'new'"
                       decoration-warning="x_project_status in ('in_progress', 'on_hold')"
                       decoration-success="x_project_status == 'done'"
                       decoration-danger="x_project_status == 'cancelled'"/>
                <field name="x_project_type" widget="badge"
                       decoration-info="x_project_type == 'client'"
                       decoration-muted="x_project_type == 'internal'"/>
            </xpath>
        </field>
    </record>

    <!-- Search view: status filters and group by -->
    <record id="view_project_search_status" model="ir.ui.view">
        <field name="name">project.project.search.status</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_projects']" position="before">
                <filter string="New"         name="status_new"
                        domain="[('x_project_status','=','new')]"/>
                <filter string="In Progress" name="status_in_progress"
                        domain="[('x_project_status','=','in_progress')]"/>
                <filter string="On Hold" name="status_on_hold"
                        domain="[('x_project_status','=','on_hold')]"/>
                <filter string="Done"        name="status_done"
                        domain="[('x_project_status','=','done')]"/>
                <filter string="Cancelled"   name="status_cancelled"
                        domain="[('x_project_status','=','cancelled')]"/>
                <separator/>
                <filter string="Client Project" name="type_client"
                        domain="[('x_project_type','=','client')]"/>
                <filter string="Internal Project" name="type_internal"
                        domain="[('x_project_type','=','internal')]"/>
                <separator/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Project Status" name="group_by_status"
                        context="{'group_by': 'x_project_status'}"/>
                <filter string="Project Type" name="group_by_type"
                        context="{'group_by': 'x_project_type'}"/>
            </xpath>
        </field>
    </record>

    <!-- Simplified Form: add project type -->
    <record id="view_project_project_form_simplified_type" model="ir.ui.view">
        <field name="name">project.project.view.form.simplified.type</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_project_view_form_simplified"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('row', 'o_settings_container')]" position="after">
                <group>
                    <field name="x_project_type" widget="radio" options="{'horizontal': true}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
