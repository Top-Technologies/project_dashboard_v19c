<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client Action Tree View -->
    <record id="view_project_client_action_tree" model="ir.ui.view">
        <field name="name">project.client.action.tree</field>
        <field name="model">project.client.action</field>
        <field name="arch" type="xml">
            <list string="Client Actions &amp; Approvals"
                  decoration-success="status == 'approved'"
                  decoration-danger="status == 'rejected'"
                  decoration-warning="status == 'pending'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="date_due"/>
                <field name="assigned_partner_id"/>
                <field name="is_client_visible"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-danger="status == 'rejected'"
                       decoration-warning="status == 'pending'"
                       decoration-info="status == 'in_progress'"/>
                <field name="is_done" widget="boolean_toggle"/>
                <field name="decision_date"/>
            </list>
        </field>
    </record>

    <!-- Client Action Form View -->
    <record id="view_project_client_action_form" model="ir.ui.view">
        <field name="name">project.client.action.form</field>
        <field name="model">project.client.action</field>
        <field name="arch" type="xml">
            <form string="Client Action / Approval">
                <header>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-success" invisible="status == 'approved'"/>
                    <button name="action_reject" string="Reject" type="object"
                            class="btn-danger" invisible="status == 'rejected'"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,in_progress,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Deliverable / Action Item"/>
                        <h1><field name="name" placeholder="e.g. Solution Design Sign-Off"/></h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="project_id"/>
                            <field name="task_id"/>
                            <field name="date_due"/>
                            <field name="assigned_partner_id"/>
                            <field name="is_client_visible"/>
                        </group>
                        <group string="Decision &amp; Audit">
                            <field name="is_done"/>
                            <field name="requested_date"/>
                            <field name="decision_date"/>
                            <field name="decision_user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Client-Facing Notes &amp; Description" name="client_notes">
                            <field name="client_visible_notes" placeholder="Visible to the client in portal or client-facing delivery views..."/>
                        </page>
                        <page string="Internal Operational Notes" name="internal_notes">
                            <field name="notes" placeholder="Internal consultant / project manager notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Client Actions -->
    <record id="action_project_client_action" model="ir.actions.act_window">
        <field name="name">Client Approvals &amp; Actions</field>
        <field name="res_model">project.client.action</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
